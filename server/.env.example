# ==============================================================================
# SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Port on which the Express backend server will run
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_posts?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/campus_posts

# Cloudinary Credentials for Image Uploads
# Obtain these free from your Cloudinary dashboard at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
